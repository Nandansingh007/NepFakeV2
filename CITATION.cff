cff-version: 1.2.0
message: "If you use this dataset, please cite it using the following metadata."

title: "NepFakeV2: A Live, auto-updating Dataset for Nepali Misinformation Detection"
version: "2.0"
date-released: "2026-11-23"   # set to the release day by `python -m pipeline.splitter release`

authors:
  - family-names: "Singh"
    given-names: "Nandan"
    email: "nandan.singhs007@gmail.com"

repository-code: "https://github.com/Nandansingh007/NepFakeV2"
url: "https://github.com/Nandansingh007/NepFakeV2"
license: "CC-BY-4.0"

abstract: >
  NepFakeV2 is the first real, non-synthetic Nepali fact-checking dataset.
  Built directly from verified fact-checks published by two active Nepali
  fact-checking organizations — TechPana and NepalFactCheck. The dataset
  contains labeled claims with a 3-class coarse label (REAL, FALSE_MISLEADING,
  UNVERIFIED) and, since version 2.0, a fine label (FALSE, MISLEADING, MIXED,
  TRUE, UNVERIFIED) with a main FALSE-vs-MISLEADING benchmark, claims and
  evidence cleaned of verdict words, stable IDs and claim-grouped splits.
  It is auto-updated weekly via GitHub Actions and grows incrementally as new
  fact-checks are published.

keywords:
  - "Nepali"
  - "misinformation"
  - "fake news"
  - "fact-checking"
  - "natural language processing"
  - "low-resource languages"

references:
  - type: website
    title: "TechPana Factcheck"
    url: "https://techpana.com/factcheck/"
  - type: website
    title: "NepalFactCheck"
    url: "https://nepalfactcheck.org"
  - type: website
    title: "NepFakeV2 on Hugging Face"
    url: "https://huggingface.co/datasets/Nandan007/NepFakeV2"